{
  "name": "@gsl-lang/gql",
  "version": "0.0.0",
  "private": true,
  "description": "GQL implementation for TypeScript",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "dependencies": {
    "@gsl-lang/core": "0.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.6.3"
  }
}
