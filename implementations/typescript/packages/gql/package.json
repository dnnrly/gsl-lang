{
  "name": "@gsl-lang/gql",
  "version": "0.1.0",
  "description": "GQL implementation for TypeScript",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnnrly/gsl-lang.git",
    "directory": "implementations/typescript/packages/gql"
  },
  "homepage": "https://github.com/dnnrly/gsl-lang/tree/main/implementations/typescript/packages/gql",
  "bugs": "https://github.com/dnnrly/gsl-lang/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "dependencies": {
    "@gsl-lang/core": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.6.3"
  }
}
