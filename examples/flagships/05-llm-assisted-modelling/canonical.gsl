set critical
set deprecated

node offer_db [team="merchandising"]
node promo_service [team="promo"]
node rules_service [team="merchandising"]
node reward_ledger [team="accounting"]
node event_bus [team="platform"]
node legacy_promo_calc [team="promo"]
node main_product_db [team="platform"]
node catalog_cache [team="storefront"] @deprecated
node returns_system [team="fulfilment"]
node catalog_service [team="storefront"]

promo_service->offer_db [protocol="sql"]
promo_service->rules_service [protocol="grpc"]
promo_service->reward_ledger [instrument="settlement"]
promo_service->event_bus [instrument="settlement", protocol="pub"]
legacy_promo_calc->main_product_db [protocol="sql"]
legacy_promo_calc->catalog_cache [protocol="tcp"]
returns_system->legacy_promo_calc [protocol="internal"]
catalog_service->offer_db [protocol="sql"]
catalog_service->catalog_cache [protocol="tcp"]