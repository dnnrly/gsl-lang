set critical
set external
set suspected

node fulfilment_service [confidence="high", source="repo", team="fulfilment"]
node order_events [confidence="high", source="config", team="platform", text="Kafka topic: order_events"]
node notification_service [confidence="high", source="repo", team="engagement"]
node payment_events [confidence="high", source="config", team="platform", text="Kafka topic: payment_events"]
node order_service [confidence="high", source="repo", team="orders"] @critical
node payment_service [confidence="high", source="repo", team="payments"] @critical

fulfilment_service->order_events [confidence="high", event="order_completed", protocol="sub", source="code"]
notification_service->payment_events [confidence="high", event="payment_settled", protocol="sub", source="code"]
notification_service->order_events [confidence="medium", event="order.completed", protocol="sub", source="code"] @suspected
order_service->order_events [confidence="high", event="order_completed", protocol="pub", source="code"]
payment_service->payment_events [confidence="high", event="payment_settled", protocol="pub", source="code"]